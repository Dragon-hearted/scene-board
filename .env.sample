# ─── Aporto API key (runtime authentication) ───
# Get your key from https://app.aporto.tech/settings
# Used at runtime by the Aporto image generation path (the primary transport
# in src/image-provider.ts). When unset, the provider silently falls back to
# the Higgsfield CLI then to the ImageEngine HTTP service.
APORTO_API_KEY=your-a...n
# ─── Higgsfield CLI (fallback image transport) ───
# Used as a secondary fallback when Aporto is unavailable. Requires the
# global @higgsfield/cli binary plus `higgsfield auth login`.
# HIGGSFIELD_BIN=higgsfield

# ─── ImageEngine HTTP service (final fallback) ───
# Base URL of the local ImageEngine service. Defaults to http://localhost:3002.
# IMAGE_ENGINE_URL=http://localhost:3002
# IMAGE_ENGINE_TIMEOUT_MS=120000
